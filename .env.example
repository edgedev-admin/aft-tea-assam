# Resend server credential. Never expose this through a NEXT_PUBLIC variable.
RESEND_API_KEY=replace_with_resend_api_key

# The From address must use a domain verified in the Resend dashboard.
CONTACT_FROM_EMAIL="AFT Techno Trade <enquiries@afttechnotrade.com>"

# Fixed recipient for website enquiries.
CONTACT_TO_EMAIL=hmtea2019@gmail.com

# Public origin used by the same-origin request check.
SITE_URL=https://www.afttechnotrade.com
